{
  "name": "devia-app",
  "version": "1.0.0",
  "private": true,
  "description": "Devia — local desktop client for driving CLI coding agents",
  "homepage": "https://dherrero.github.io/devia/",
  "main": "dist/main/src-main/shell/main.js",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.cjs && node scripts/write-platform-marker.cjs"
  },
  "build": {
    "appId": "com.devia.app",
    "productName": "Devia",
    "copyright": "Copyright © 2026 Dani Herrero",
    "electronVersion": "41.7.0",
    "publish": [
      {
        "provider": "github",
        "owner": "dherrero",
        "repo": "devia",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "renderer/assets/images/Devia.PNG",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "apps/desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "apps/desktop/build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Dani Herrero <dherrero82@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "node-pty": "^1.1.0"
  },
  "author": "Dani Herrero",
  "license": "Apache-2.0"
}
