registry=https://registry.npmjs.org/
# vitest 4.x ships peer-optional companions (browser-playwright, ui…) at the
# exact same version. Once we bump a peer-dep tree (Angular, Nx, jose…) npm 11
# rejects the install on strict peer resolution even though we don't use those
# extras. Defaulting to legacy-peer-deps lets npm ci/install proceed cleanly in
# CI + local without sprinkling the flag everywhere.
legacy-peer-deps=true
