{
  "agent": "opencode",
  "scenario": "kit",
  "wiring": {
    "command": "opencode",
    "argv": [
      "run",
      "--format",
      "json",
      "--model",
      "opencode/deepseek-v4.1-flash-free",
      "--agent",
      "plan"
    ],
    "stdin": {
      "format": "text",
      "systemHeader": true
    },
    "mcpServers": [
      "devia-kanban",
      "devia-memory",
      "devia-ui"
    ],
    "systemPrompt": {
      "channel": "stdin-prepend",
      "announcesUiTools": true,
      "announcesMemory": true,
      "mentionsKanban": true,
      "kitMapping": true,
      "kitBootstrap": true
    },
    "uiServer": {
      "skillsDirs": 1,
      "subagentsDir": false
    },
    "configEnv": {
      "OPENCODE_CONFIG": true
    }
  },
  "behaviour": {
    "exitCode": 0,
    "eventTypes": [
      "session_started",
      "status",
      "text_delta",
      "tool_result",
      "tool_use",
      "usage"
    ],
    "sessionStarted": true,
    "deviaTools": [
      "mcp__devia-ui__devia_skill"
    ],
    "uiCards": [],
    "loadedSkill": true,
    "askedBeforeBuilding": true,
    "wroteCode": false,
    "usedKanban": false
  }
}
