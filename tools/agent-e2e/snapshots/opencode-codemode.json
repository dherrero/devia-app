{
  "agent": "opencode",
  "scenario": "codemode",
  "wiring": {
    "command": "opencode",
    "argv": [
      "run",
      "--format",
      "json",
      "--model",
      "opencode/deepseek-v4.1-flash-free",
      "--dangerously-skip-permissions",
      "--session",
      "<SESSION>"
    ],
    "stdin": {
      "format": "text",
      "systemHeader": true
    },
    "mcpServers": [
      "devia-code-mode",
      "devia-kanban",
      "devia-memory",
      "devia-ui"
    ],
    "systemPrompt": {
      "channel": "stdin-prepend",
      "announcesUiTools": true,
      "announcesMemory": true,
      "mentionsKanban": false
    },
    "uiServer": {
      "skillsDirs": 0,
      "subagentsDir": false
    },
    "configEnv": {
      "OPENCODE_CONFIG": true
    }
  },
  "behaviour": {
    "exitCode": 0,
    "eventTypes": [
      "session_started",
      "status",
      "text_delta",
      "tool_result",
      "tool_use",
      "usage"
    ],
    "sessionStarted": true,
    "deviaTools": [
      "mcp__devia-code-mode__get_types",
      "mcp__devia-code-mode__run_script",
      "mcp__devia-code-mode__search_tools"
    ],
    "uiCards": [],
    "usedRunScript": true,
    "runScriptCalls": 1,
    "nestedCalls": 4,
    "sawDirectServerTools": false,
    "answeredRight": true,
    "scriptResultShown": true
  }
}
