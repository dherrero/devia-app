{
  "agent": "codex",
  "scenario": "kit",
  "wiring": {
    "command": "codex",
    "argv": [
      "exec",
      "--json",
      "--skip-git-repo-check",
      "-C",
      "<WS>/proj",
      "--add-dir",
      "<WS>",
      "--add-dir",
      "<DEVIA>/kits/superpowers/<VERSION>",
      "--sandbox",
      "danger-full-access"
    ],
    "stdin": {
      "format": "text",
      "systemHeader": true
    },
    "mcpServers": [],
    "systemPrompt": {
      "channel": "stdin-prepend",
      "announcesUiTools": true,
      "announcesMemory": true,
      "mentionsKanban": true,
      "kitMapping": true,
      "kitBootstrap": true
    },
    "uiServer": null
  },
  "behaviour": {
    "exitCode": 0,
    "eventTypes": [
      "raw",
      "session_started",
      "status",
      "text_delta",
      "tool_result",
      "tool_use",
      "usage"
    ],
    "sessionStarted": true,
    "deviaTools": [
      "mcp__devia-ui__devia_skill"
    ],
    "uiCards": [],
    "loadedSkill": true,
    "askedBeforeBuilding": true,
    "wroteCode": false,
    "usedKanban": false
  }
}
