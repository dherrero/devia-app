{
  "agent": "pi",
  "scenario": "apply",
  "wiring": {
    "command": "pi",
    "argv": [
      "--mode",
      "rpc",
      "-e",
      "<DEVIA>/tmp/pi-mcp-<ID>.mjs",
      "--append-system-prompt",
      "<TMP>/devia-system-prompt-<RUN>.md"
    ],
    "stdin": {
      "format": "jsonl",
      "types": [
        "get_state",
        "prompt"
      ]
    },
    "mcpServers": [
      "devia-kanban",
      "devia-memory",
      "devia-ui"
    ],
    "systemPrompt": {
      "channel": "argv-file",
      "announcesUiTools": true,
      "announcesMemory": true,
      "mentionsKanban": false
    },
    "uiServer": {
      "skillsDirs": 0,
      "subagentsDir": false
    }
  },
  "behaviour": {
    "exitCode": 0,
    "eventTypes": [
      "session_started",
      "status",
      "text_delta",
      "thinking_delta",
      "tool_result",
      "tool_use",
      "turn_end",
      "usage"
    ],
    "sessionStarted": true,
    "deviaTools": [
      "mcp__devia-kanban__kanban_create_spec",
      "mcp__devia-memory__mem_save",
      "mcp__devia-ui__devia_ask_user",
      "mcp__devia-ui__devia_todo"
    ],
    "uiCards": [
      "ask_user",
      "todo"
    ]
  }
}
