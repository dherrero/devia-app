{
  "agent": "acp-fake",
  "scenario": "apply",
  "wiring": {
    "command": "acp-fake",
    "argv": [
      "acp"
    ],
    "stdin": {
      "format": "jsonrpc",
      "methods": [
        "initialize",
        "session/new",
        "session/set_mode",
        "session/prompt"
      ]
    },
    "mcpServers": [
      "devia-kanban",
      "devia-memory",
      "devia-ui"
    ],
    "systemPrompt": {
      "channel": "stdin-prepend",
      "announcesUiTools": true,
      "announcesMemory": true,
      "mentionsKanban": false
    },
    "uiServer": null,
    "acp": {
      "methods": [
        "initialize",
        "session/new",
        "session/set_mode",
        "session/prompt"
      ],
      "loadedSession": false,
      "mcpServers": [
        "devia-kanban",
        "devia-memory",
        "devia-ui"
      ],
      "mode": [
        "default"
      ],
      "clientCapabilities": {
        "fs": {
          "readTextFile": false,
          "writeTextFile": false
        },
        "terminal": false
      },
      "cwd": "<WS>/proj",
      "systemPromptSeen": true
    }
  },
  "behaviour": {
    "exitCode": 0,
    "eventTypes": [
      "session_started",
      "status",
      "text_delta",
      "tool_result",
      "tool_use",
      "turn_end"
    ],
    "sessionStarted": true,
    "deviaTools": [
      "mcp__devia-kanban__kanban_create_spec",
      "mcp__devia-memory__mem_save",
      "mcp__devia-ui__devia_todo"
    ],
    "uiCards": [
      "ask_user"
    ]
  }
}
