{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@core": ["src/core/index.ts"],
      "@core/*": ["src/core/*"],
      "@models/*": ["src/models/*"],
      "@utils": ["src/utils/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
