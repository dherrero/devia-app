{
  "name": "devia",
  "version": "0.35.0",
  "description": "Devia — local desktop client for driving CLI coding agents",
  "license": "Apache-2.0",
  "private": true,
  "author": {
    "name": "Daniel Herrero Tomás"
  },
  "homepage": "https://dherrero.github.io/devia/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dherrero/devia-app.git"
  },
  "bugs": {
    "url": "https://github.com/dherrero/devia-app/issues"
  },
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "start:desktop": "nx run desktop:start",
    "dev:desktop": "nx serve desktop ",
    "dev:desktop:live": "node scripts/kill-port.cjs 4300 && nx run desktop:serve:live",
    "clean": "nx reset && rm -fr tmp dist .angular",
    "build:desktop": "nx build desktop",
    "lint:desktop": "nx lint desktop",
    "format": "prettier --write \"**/*.{ts,js,json,html,scss,css,md}\"",
    "typecheck:desktop": "nx typecheck desktop",
    "test:desktop": "nx test desktop",
    "test:desktop:main": "nx test:main desktop",
    "test:desktop:renderer": "nx test:renderer desktop",
    "pack:desktop": "nx package desktop",
    "pack:desktop:win": "nx package desktop --configuration=win",
    "pack:desktop:mac": "nx package desktop --configuration=mac",
    "pack:desktop:linux": "nx package desktop --configuration=linux"
  },
  "dependencies": {
