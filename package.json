{
  "name": "devia-app",
  "version": "0.36.0",
  "private": true,
  "description": "Devia — local desktop client for driving CLI coding agents",
  "license": "Apache-2.0",
  "author": "Dani Herrero",
  "homepage": "https://dherrero.github.io/devia/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dherrero/devia-app.git"
  },
  "bugs": {
    "url": "https://github.com/dherrero/devia-app/issues"
  },
  "main": "dist/main/main/shell/main.js",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-native.cjs && node scripts/write-platform-marker.cjs",
    "dev": "concurrently -k -n main,renderer,electron \"npm:watch:main\" \"npm:watch:renderer\" \"wait-on file:dist/main/main/shell/main.js file:dist/renderer/browser/index.html && cross-env ELECTRON_ENABLE_LOGGING=1 electron --remote-debugging-port=9222 . --dev\"",
    "dev:live": "node scripts/kill-port.cjs 4300 && concurrently -k -n main,renderer,electron \"npm:watch:main\" \"npm:serve:renderer\" \"wait-on file:dist/main/main/shell/main.js tcp:4300 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:4300 ELECTRON_ENABLE_LOGGING=1 electron --remote-debugging-port=9222 . --dev\"",
    "start": "npm run build && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "ng build --project devia-renderer --configuration=production",
    "watch:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "watch:renderer": "ng build --project devia-renderer --configuration=development --watch",
    "serve:renderer": "ng serve --project devia-renderer --configuration=development",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint \"src/main/**/*.ts\" \"src/shared/**/*.ts\" \"src/renderer/**/*.ts\" \"src/renderer/**/*.html\" \"tools/**/*.ts\"",
    "test": "npm run test:main && npm run test:renderer && npm run test:libs",
    "test:main": "vitest run --config vitest.config.ts",
    "test:renderer": "vitest run --config vitest.angular.config.ts",
    "test:libs": "vitest run --config src/libs/ui/vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "pack": "electron-builder",
    "pack:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "pack:win": "electron-builder --win",
    "pack:mac": "electron-builder --mac",
    "pack:linux": "electron-builder --linux",
    "clean": "rm -fr dist release coverage .angular tmp"
  },
  "build": {
    "appId": "com.devia.app",
    "productName": "Devia",
    "copyright": "Copyright © 2026 Dani Herrero",
    "electronVersion": "41.7.0",
    "publish": [
      {
        "provider": "github",
        "owner": "dherrero",
        "repo": "devia",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "src/renderer/assets/images/Devia.PNG",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Dani Herrero <dherrero82@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.1",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular-devkit/build-angular": "^21.2.13",
    "@angular/animations": "^21.2.15",
    "@angular/cdk": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/common": "^21.2.15",
    "@angular/compiler": "^21.2.15",
    "@angular/compiler-cli": "^21.2.15",
    "@angular/core": "^21.2.15",
    "@angular/forms": "^21.2.15",
    "@angular/language-service": "^21.2.15",
    "@angular/localize": "^21.2.15",
    "@angular/material": "^21.2.13",
    "@angular/platform-browser": "^21.2.15",
    "@angular/platform-browser-dynamic": "^21.2.15",
    "@angular/router": "^21.2.15",
    "@electron/rebuild": "^4.0.4",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lucide/angular": "^1.16.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@nx/eslint-plugin": "^22.7.5",
    "@nx/js": "^22.7.5",
    "@playwright/test": "^1.61.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bootstrap": "^5.3.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.11",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "marked": "^18.0.5",
    "material-icons": "^1.13.14",
    "nx": "^22.7.2",
    "prettier": "^3.8.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10",
    "zone.js": "^0.16.2"
  },
  "overrides": {
    "eslint-config-prettier": "^10.0.0",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.1",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "^5.0.6",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.2",
    "hono": "^4.12.22",
    "qs": "^6.15.2",
    "sharp": "^0.35.0",
    "tar": "^7.5.15",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "electron-updater": {
      "js-yaml": "^4.3.2"
    }
  }
}
