<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened Runtime exceptions required to notarize Devia.
    Devia spawns child CLIs (claude/codex/gemini/...) via node-pty/child_process
    and starts the devia-memory MCP server with ELECTRON_RUN_AS_NODE=1, so the
    runtime needs JIT, unsigned executable memory, library-validation relaxation
    and DYLD env-var inheritance. Removing any of these breaks agent/terminal/MCP
    spawning in the signed build.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
